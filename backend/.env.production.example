# Parenthèse, API en production sans Docker (PM2 + nginx, voir deploy/).
# Copiez ce fichier en backend/.env sur le serveur et remplacez chaque valeur d'exemple.
# Pour une installation Docker, utilisez plutôt le .env.example à la racine du dépôt.

NODE_ENV=production
PORT=4000
# nginx sur la même machine : l'API n'écoute que la boucle locale, et ne croit que nginx pour
# l'adresse des visiteurs (limites d'essais sur les mots de passe).
HOST=127.0.0.1
TRUST_PROXY=loopback

# Base PostgreSQL dédiée. L'API refuse de démarrer en production avec l'URL de développement.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/parenthese"

# 16 caractères minimum. Générer avec : openssl rand -base64 48
JWT_SECRET=""
# Durée de vie des sessions (compte) et des accès par lien partagé.
JWT_EXPIRES_IN="7d"
JWT_TREE_ACCESS_EXPIRES_IN="24h"

# Adresses autorisées à appeler l'API, sans slash final, séparées par des virgules.
CORS_ORIGIN="https://arbre.example.org"

# Dossier des médias envoyés. Un chemin relatif part du dossier backend/.
MEDIA_STORAGE_PATH="/var/lib/parenthese/media"

# Reconnaissance des visages : instances Immich autorisées sur ce serveur, séparées par des
# virgules. Entrée « Libellé=https://adresse » ou « https://adresse » (nom d'hôte comme libellé,
# donc un libellé si deux instances partagent un nom). Les administrateurs de chaque arbre choisissent
# l'instance par son nom et donnent leur propre clé d'API. Sans cette liste, la fonction reste éteinte.
IMMICH_ALLOWED_API_URLS=""

# Création de compte. À false, seuls les comptes existants se connectent ; une instance sans aucun
# compte accepte quand même le premier, celui du propriétaire.
ALLOW_REGISTRATION=true
# Connexion par un fournisseur OIDC, éteinte sans OIDC_ISSUER (voir le README). PASSWORD_LOGIN=false retire
# les mots de passe Parenthèse.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""
OIDC_PROVIDER_NAME="SSO"
OIDC_REQUIRE_VERIFIED_EMAIL=true
PASSWORD_LOGIN=true
